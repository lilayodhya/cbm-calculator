# Copy this file to .env and set the values only on the deployment server.
# Do not commit .env or put DB_* values in a VITE_* variable.
# Leave blank in production so the browser calls IIS at /api. Set this only
# for local development without IIS, e.g. http://localhost:3001.
VITE_API_URL=
# Use the exact https:// host name used by users. Multiple origins can be
# comma-separated only when genuinely required.
FRONTEND_ORIGIN=https://cbm.example.internal
DB_SERVER=your-sql-server-hostname
DB_PORT=1433
DB_DATABASE=your_database_name
DB_USERNAME=your_read_only_username
DB_PASSWORD=replace_with_the_database_password
# PEM file for the CA that issued the SQL Server certificate. Required when
# that internal CA is not already trusted by the Node.js runtime.
DB_CA_CERT_PATH=C:\ProgramData\CBM-ALS\certs\office-sql-ca.pem
